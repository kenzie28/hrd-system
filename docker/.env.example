# =============================================================================
# HRD System — docker compose environment
# =============================================================================
# Copy this file to `.env` (in this same `docker/` directory) and adjust as
# needed. `./build.sh` / `./deploy.sh` do this automatically on first run, and
# generate random values for API_KEY and DJANGO_SECRET_KEY if left blank.
#
# Normal deploy (any host/IP/domain):
#   git pull && ./build.sh && ./deploy.sh
# Frontends use same-origin /api (nginx proxies to backend and injects API_KEY).
# You do NOT need to set absolute API URLs or open special firewall rules
# between frontend and backend ports from the browser.
# =============================================================================

# --- Host ports ---
BACKEND_PORT=8028
ADMIN_FRONTEND_PORT=5128
PORTAL_FRONTEND_PORT=5129

# --- MySQL ---
# Data is persisted on the `hrd-system-db` docker volume.
DB_NAME=hrd_system
DB_USER=admin
DB_PASSWORD=Bears0204
MYSQL_ROOT_PASSWORD=Bears0204

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*

# Django superuser (django-admin site only; HR admin uses karyawan_id 0000003)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=Bears0204
DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- Backend API key ---
# Required on every request to /api/ (header X-Api-Key).
# Generated automatically by ./build.sh if left blank.
# Frontend nginx containers get the same value and inject it when proxying /api.
API_KEY=

# --- Optional advanced: absolute browser→API URL ---
# Leave unset so SPAs use relative /api through the frontend nginx proxy.
# Only set if the browser must call the backend on another host (unusual).
# ADMIN_VITE_API_URL=http://example.com:8028/api
# PORTAL_VITE_API_URL=http://example.com:8028/api
# If you set those, also bake matching keys:
# ADMIN_VITE_API_KEY=${API_KEY}
# PORTAL_VITE_API_KEY=${API_KEY}

# --- Docker Hub (for ./push.sh) ---
# DOCKERHUB_USERNAME=your-dockerhub-username
# Optional image name prefix (default: hrd) → username/hrd-backend, etc.
# IMAGE_PREFIX=hrd
