# =============================================================================
# HRD System — docker compose environment
# =============================================================================
# Copy this file to `.env` (in this same `docker/` directory) and adjust as
# needed. `./build.sh` will do this automatically on first run, and will
# generate random values for API_KEY and DJANGO_SECRET_KEY if left blank.
# =============================================================================

# --- Host ports ---
BACKEND_PORT=8028
ADMIN_FRONTEND_PORT=5128
PORTAL_FRONTEND_PORT=5129

# --- MySQL ---
# Data is persisted on the `mysql_data` docker volume.
DB_NAME=hrd_system
DB_USER=admin
DB_PASSWORD=Bears0204
MYSQL_ROOT_PASSWORD=Bears0204

# --- Django ---
DJANGO_SECRET_KEY=17233358bb10e3762bb286ab5d9c634a5b8a0f78099d61f18674a86a915993a7
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*

# Django superuser (django-admin + admin-frontend login)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=Bears0204
DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- Backend API key ---
# Required on every request to /api/ via the `X-Api-Key` header.
# Generated automatically by ./build.sh if left blank.
API_KEY=dc0b59817803f443b53a942ccc6f773455c924470c3c9958625e1a7d2442b8d7

# --- Docker Hub ---
DOCKERHUB_USERNAME=kenzie28